Attribute VB_Name = "CwlApiSync"
Option Explicit

' ============================================================
' Clan War League (CWL) Live Data Synchronization
' ------------------------------------------------------------
' Part of the Clan Operations & Analytics Automation Tool.
'
' This module queries the Clash of Clans API to retrieve
' Clan War League (CWL) battle results and synchronizes
' the star counts with the local tracking workbook.
'
' DEPENDENCY NOTE:
' This module requires a JSON parsing library for VBA, such as
' VBA-JSON (https://github.com/VBA-tools/VBA-JSON).
' The `ParseJson` function used below is provided by that library.
' ============================================================

' --- CONFIGURATION ---
' WARNING: Never commit real API tokens to a public repository.
Private Const CLAN_TAG As String = "YOUR_CLAN_TAG_HERE" ' e.g., "ABC123" (without the #)
Private Const API_TOKEN As String = "YOUR_API_TOKEN_HERE"
Private Const API_BASE_URL As String = "https://api.clashofclans.com/v1/"

' Worksheet Configuration
Private Const SHEET_NAME As String = "CurrentCwl"
Private Const CELL_TARGET_DAY As String = "N2"
Private Const COL_DAY As Long = 1
Private Const COL_PLAYER_NAME As Long = 3
Private Const COL_ACTUAL_STARS As Long = 10
Private Const MAX_ROSTER_ROWS As Long = 351
' ---------------------

Public Sub SyncCwlLiveData()

    Dim http As Object
    Set http = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    
    Dim ws As Worksheet
    Set ws = ThisWorkbook.Sheets(SHEET_NAME)
    
    ' 1. Read the target day from the configuration cell
    Dim targetDay As Long
    If Not IsNumeric(ws.Range(CELL_TARGET_DAY).Value) Then
        MsgBox "Invalid Day in " & CELL_TARGET_DAY & ". CWL only runs Day 1 to 7.", vbCritical, "Input Error"
        Exit Sub
    End If
    
    targetDay = CLng(ws.Range(CELL_TARGET_DAY).Value)
    If targetDay < 1 Or targetDay > 7 Then
        MsgBox "Invalid Day in " & CELL_TARGET_DAY & ". CWL only runs Day 1 to 7.", vbCritical, "Input Error"
        Exit Sub
    End If
    
    ' URL-encode the clan tag
    Dim safeTag As String
    safeTag = "%23" & UCase(CLAN_TAG)
    
    ' 2. Query the CWL League Group endpoint
    Dim urlGroup As String
    urlGroup = API_BASE_URL & "clans/" & safeTag & "/currentwar/leaguegroup"
    
    On Error Resume Next
    http.Open "GET", urlGroup, False
    http.setRequestHeader "Authorization", "Bearer " & API_TOKEN
    http.setRequestHeader "Accept", "application/json"
    http.Send
    
    If Err.Number <> 0 Then
        MsgBox "Network connection failed. Please check your internet connection.", vbCritical, "Network Error"
        Exit Sub
    End If
    On Error GoTo 0
    
    If http.Status = 404 Then
        MsgBox "Your clan is not currently in a Clan War League.", vbCritical, "Data Not Found"
        Exit Sub
    ElseIf http.Status <> 200 Then
        MsgBox "API request failed with status " & http.Status & ".", vbCritical, "API Error"
        Exit Sub
    End If
    
    ' 3. Parse the League Group JSON
    Dim GroupJson As Object
    Set GroupJson = ParseJson(http.responseText)
    
    If GroupJson("state") = "notInWar" Then
        MsgBox "CWL has ended or not started.", vbInformation, "Standby"
        Exit Sub
    End If
    
    ' Defensive Check: Verify the server has seeded the rounds
    If Not GroupJson.Exists("rounds") Then
        MsgBox "CWL rounds have not been fully generated by the servers yet.", vbExclamation, "Standby"
        Exit Sub
    End If
    
    Dim roundsCol As Object
    Set roundsCol = GroupJson("rounds")
    
    ' Defensive Check: Verify the target day exists in the current matrix
    If targetDay > roundsCol.Count Then
        MsgBox "Data for Day " & targetDay & " is not available yet.", vbInformation, "Out of Bounds"
        Exit Sub
    End If
    
    Dim roundDict As Object
    Dim warTags As Object
    Set roundDict = roundsCol(targetDay)
    Set warTags = roundDict("warTags")
    
    ' 4. Iterate through the war tags to find the clan's specific battle
    Dim warTag As Variant
    Dim warUrl As String
    Dim WarJson As Object
    Dim myClan As Object
    Dim foundWar As Boolean
    
    foundWar = False
    
    For Each warTag In warTags
        ' "#0" indicates the server hasn't generated this war yet
        If CStr(warTag) <> "#0" Then
            warUrl = API_BASE_URL & "clanwarleagues/wars/" & Replace(CStr(warTag), "#", "%23")
            
            http.Open "GET", warUrl, False
            http.setRequestHeader "Authorization", "Bearer " & API_TOKEN
            http.setRequestHeader "Accept", "application/json"
            http.Send
            
            If http.Status = 200 Then
                Set WarJson = ParseJson(http.responseText)
                
                ' Check if we are the Clan or the Opponent
                If WarJson("clan")("tag") = "#" & CLAN_TAG Then
                    Set myClan = WarJson("clan")
                    foundWar = True
                    Exit For
                ElseIf WarJson("opponent")("tag") = "#" & CLAN_TAG Then
                    Set myClan = WarJson("opponent")
                    foundWar = True
                    Exit For
                End If
            End If
        End If
    Next warTag
    
    If Not foundWar Then
        MsgBox "Could not locate your clan's battle data for Day " & targetDay & ".", vbInformation, "Data Unavailable"
        Exit Sub
    End If
    
    ' 5. Extract the attacks into a dictionary for fast lookup
    Dim dictAttacks As Object
    Set dictAttacks = CreateObject("Scripting.Dictionary")
    dictAttacks.CompareMode = vbTextCompare ' Case-insensitive name matching
    
    Dim member As Object
    Dim playerName As String
    Dim stars As Long
    
    For Each member In myClan("members")
        playerName = CStr(member("name"))
        ' In CWL, members only get 1 attack (index 1 in VBA-JSON)
        If member.Exists("attacks") Then
            stars = CLng(member("attacks")(1)("stars"))
            If Not dictAttacks.Exists(playerName) Then
                dictAttacks.Add playerName, stars
            End If
        End If
    Next member
    
    ' 6. Write data to the workbook
    Dim i As Long
    Dim sheetName As String
    Dim updatesMade As Long
    updatesMade = 0
    
    Application.ScreenUpdating = False
    
    For i = 2 To MAX_ROSTER_ROWS
        If Val(ws.Cells(i, COL_DAY).Value) = targetDay Then
            sheetName = CStr(ws.Cells(i, COL_PLAYER_NAME).Value)
            
            If dictAttacks.Exists(sheetName) Then
                stars = CLng(dictAttacks(sheetName))
                
                ' Only update and count if the value has actually changed
                If Val(ws.Cells(i, COL_ACTUAL_STARS).Value) <> stars Then
                    ws.Cells(i, COL_ACTUAL_STARS).Value = stars
                    updatesMade = updatesMade + 1
                End If
            End If
        End If
    Next i
    
    Application.ScreenUpdating = True
    
    MsgBox "CWL Sync Complete. " & updatesMade & " new attacks logged for Day " & targetDay & ".", vbInformation, "System Update"
    
End Sub